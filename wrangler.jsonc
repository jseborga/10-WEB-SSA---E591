{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ssa-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ssa-web",
      // Reemplazar con el id que devuelve `wrangler d1 create ssa-web`
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "ssa-web-media"
    }
  ],
  "vars": {
    // Dominio público del sitio (también editable en el panel: Sitio → URL).
    "SITE_URL": "https://ssa-web.workers.dev"
  }
}
